# Copy to %LOCALAPPDATA%\3dsmax-mcp\.env and fill in the key.
# Loaded by the native bridge at plugin start and on /reload.
# Real environment variables (set via `setx` or shell) override anything here.
#
# Only consumed when the in-Max chat is enabled (MCP_ENABLE_CHAT=1 in the
# MCP server environment). The chat talks to Anthropic's Messages API
# directly — no OpenAI / OpenRouter fallback.

ANTHROPIC_API_KEY=
